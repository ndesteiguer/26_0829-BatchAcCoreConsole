<Window x:Class="BatchAcCore.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Batch AcCoreConsole" Height="840" Width="1180" MinHeight="650" MinWidth="900">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
        </Style>
    </Window.Resources>
    <DockPanel Margin="16">
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <Button Content="Reset Profile" Click="NewProfile_Click" Padding="12,5" Margin="0,0,8,6" IsEnabled="{Binding CanEdit}" />
            <Button Content="Open Profile" Click="OpenProfile_Click" Padding="12,5" Margin="0,0,8,6" />
            <Button Content="Save Profile" Click="SaveProfile_Click" Padding="12,5" Margin="0,0,8,6" />
            <Button Content="Save Profile As..." Click="SaveProfileAs_Click" Padding="12,5" Margin="0,0,24,6" />
            <Button Content="Run Preflight" Click="RunPreflight_Click" Padding="12,5" Margin="0,0,8,6" IsEnabled="{Binding CanEdit}" />
            <Button Content="Start Batch" Click="StartBatch_Click" Padding="12,5" Margin="0,0,8,6" IsEnabled="{Binding CanStart}" Style="{StaticResource PrimaryButton}" />
            <Button Content="Create Failed-Only Rerun" Click="CreateRerun_Click" Padding="12,5" Margin="0,0,8,6" IsEnabled="{Binding CanCreateRerun}" />
            <Button Content="Open Selected Log" Click="OpenSelectedLog_Click" Padding="12,5" Margin="0,0,8,6" IsEnabled="{Binding CanOpenSelectedLog}" />
            <Button Content="Open Batch Summary" Click="OpenBatchSummary_Click" Padding="12,5" Margin="0,0,8,6" IsEnabled="{Binding CanOpenBatchSummary}" />
            <Button Content="Open Combined CSV" Click="OpenCombinedCsv_Click" Padding="12,5" Margin="0,0,8,6" IsEnabled="{Binding CanOpenCombinedCsv}" />
            <Button Content="Cancel Queued Work" Click="Cancel_Click" Padding="12,5" Margin="0,0,0,6" IsEnabled="{Binding IsRunning}" />
        </WrapPanel>

        <StatusBar DockPanel.Dock="Bottom" Margin="0,12,0,0" HorizontalContentAlignment="Stretch">
            <StatusBarItem HorizontalContentAlignment="Stretch">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding StatusText}" />
                    <Separator Grid.Column="1" Margin="10,0" />
                    <TextBlock Grid.Column="2" Text="{Binding ProgressText}" VerticalAlignment="Center" />
                    <ProgressBar Grid.Column="3" Height="14" Margin="8,0,0,0" Minimum="0" Maximum="{Binding ProgressMaximum}" Value="{Binding ProgressValue, Mode=OneWay}" />
                </Grid>
            </StatusBarItem>
        </StatusBar>

        <TabControl>
            <TabItem Header="Profile">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="8" IsEnabled="{Binding CanEdit}" PreviewGotKeyboardFocus="ProfileEditor_PreviewGotKeyboardFocus">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Core Console executable" VerticalAlignment="Center" Margin="0,6" />
                        <DockPanel Grid.Row="0" Grid.Column="1" Margin="0,3"><Button DockPanel.Dock="Right" Content="Browse..." Click="BrowseCoreConsole_Click" Margin="8,0,0,0" /><TextBox Text="{Binding Settings.AcCoreConsolePath, UpdateSourceTrigger=PropertyChanged}" /></DockPanel>
                        <TextBlock Grid.Row="1" Text="AutoLISP routine (.lsp)" VerticalAlignment="Center" Margin="0,6" />
                        <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,3"><Button DockPanel.Dock="Right" Content="Browse..." Click="BrowseLisp_Click" Margin="8,0,0,0" /><TextBox Text="{Binding Settings.LispFilePath, UpdateSourceTrigger=PropertyChanged}" /></DockPanel>
                        <RadioButton Grid.Row="2" Content="Drawing list file" GroupName="InputMethod" IsChecked="{Binding IsFileListInput, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,6" />
                        <DockPanel Grid.Row="2" Grid.Column="1" Margin="0,3" IsEnabled="{Binding IsFileListInput}"><Button DockPanel.Dock="Right" Content="Browse..." Click="BrowseDrawingList_Click" Margin="8,0,0,0" /><TextBox Text="{Binding Settings.FileListPath, UpdateSourceTrigger=PropertyChanged}" /></DockPanel>
                        <RadioButton Grid.Row="3" Content="Input directory" GroupName="InputMethod" IsChecked="{Binding IsInputDirectoryInput, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,6" />
                        <DockPanel Grid.Row="3" Grid.Column="1" Margin="0,3" IsEnabled="{Binding IsInputDirectoryInput}"><Button DockPanel.Dock="Right" Content="Browse..." Click="BrowseInputDirectory_Click" Margin="8,0,0,0" /><TextBox Text="{Binding Settings.InputDirectory, UpdateSourceTrigger=PropertyChanged}" /></DockPanel>
                        <CheckBox Grid.Row="4" Grid.Column="1" Content="Search this input directory recursively" IsChecked="{Binding Settings.Recursive}" IsEnabled="{Binding IsInputDirectoryInput}" Margin="0,6" />
                        <TextBlock Grid.Row="5" Text="Work directory" VerticalAlignment="Center" Margin="0,6" />
                        <DockPanel Grid.Row="5" Grid.Column="1" Margin="0,3"><Button DockPanel.Dock="Right" Content="Browse..." Click="BrowseWorkDirectory_Click" Margin="8,0,0,0" /><TextBox Text="{Binding Settings.WorkDirectory, UpdateSourceTrigger=PropertyChanged}" /></DockPanel>
                        <TextBlock Grid.Row="6" Text="Results directory" VerticalAlignment="Center" Margin="0,6" />
                        <DockPanel Grid.Row="6" Grid.Column="1" Margin="0,3"><Button DockPanel.Dock="Right" Content="Browse..." Click="BrowseResultsDirectory_Click" Margin="8,0,0,0" /><TextBox Text="{Binding Settings.ResultsDirectory, UpdateSourceTrigger=PropertyChanged}" /></DockPanel>
                        <TextBlock Grid.Row="7" Text="Workers" VerticalAlignment="Center" Margin="0,6" />
                        <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding Settings.WorkerCount, UpdateSourceTrigger=PropertyChanged}" Margin="0,3" Width="100" HorizontalAlignment="Left" />
                        <TextBlock Grid.Row="8" Text="Timeout (minutes)" VerticalAlignment="Center" Margin="0,6" />
                        <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding Settings.TimeoutMinutes, UpdateSourceTrigger=PropertyChanged}" Margin="0,3" Width="100" HorizontalAlignment="Left" />
                        <CheckBox Grid.Row="9" Grid.Column="1" Content="Skip invalid drawing-list entries" IsChecked="{Binding Settings.SkipInvalidFileListEntries}" Margin="0,6" />
                        <CheckBox Grid.Row="10" Grid.Column="1" Content="Save drawings after successful processing" IsChecked="{Binding Settings.SaveAfterRun}" Margin="0,6" />
                        <CheckBox Grid.Row="11" Grid.Column="1" Content="Keep generated scripts" IsChecked="{Binding Settings.KeepScripts}" Margin="0,6" />
                        <CheckBox Grid.Row="12" Grid.Column="1" Content="Create per-job log files" IsChecked="{Binding Settings.CreateLogFiles}" Margin="0,6" />
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="PreflightQueueTab" Header="Preflight &amp; Queue">
                <Grid Margin="8">
                    <Grid.RowDefinitions><RowDefinition Height="2*" /><RowDefinition Height="3*" /></Grid.RowDefinitions>
                    <DataGrid ItemsSource="{Binding Diagnostics}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Margin="0,0,0,8">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Result" Binding="{Binding Severity}" Width="100" />
                            <DataGridTextColumn Header="Check" Binding="{Binding Check}" Width="180" />
                            <DataGridTextColumn Header="Details" Binding="{Binding Message}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Queue}" SelectedItem="{Binding SelectedQueueItem}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Drawing" Binding="{Binding Name}" Width="220" />
                            <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="110" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110" />
                            <DataGridTextColumn Header="Worker" Binding="{Binding WorkerId}" Width="70" />
                            <DataGridTextColumn Header="Exit" Binding="{Binding ExitCode}" Width="60" />
                            <DataGridTextColumn Header="Started (UTC)" Binding="{Binding StartedUtc}" Width="160" />
                            <DataGridTextColumn Header="Finished (UTC)" Binding="{Binding FinishedUtc}" Width="160" />
                            <DataGridTextColumn Header="Elapsed" Binding="{Binding Elapsed}" Width="100" />
                            <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="280" />
                            <DataGridTextColumn Header="Log" Binding="{Binding LogPath}" Width="200" />
                            <DataGridTextColumn Header="Full path" Binding="{Binding Drawing}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="{Binding RunOutputHeader}">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" Text="Profile modified — displayed results are from the previous run." Foreground="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" FontWeight="SemiBold" Margin="0,0,0,8">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsResultsStale}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding RunSummary}" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBox Text="{Binding OutputText, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
